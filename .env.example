# Robinhood Chain account; replace placeholders before running.
LIGHTER_NETWORK=robinhood
LIGHTER_ACCOUNT_INDEX=YOUR_ACCOUNT_INDEX
LIGHTER_API_KEY_INDEX=YOUR_API_KEY_INDEX
LIGHTER_API_PRIVATE_KEY=YOUR_API_PRIVATE_KEY
SYMBOL=INTC

# Grid and symbol risk limits.
gridStep=0.01
gridLines=60
orderSize=0.2
lowLimit=50
highLimit=90
baseline=60
left=0
maxposi=1000
MAX_LOSS=-8000

# Account-wide maintenance margin ratio and effective leverage limits.
MMR=0.2
leverage=5

# Local event processing, REST reconciliation, and HTTP batch size.
CHECK_INTERVAL=0.8
REST_INTERVAL=60
DISCONNECT_TIMEOUT=30
patch=15

# Cancel orders on this symbol at exit; never close positions automatically.
CANCEL_ON_EXIT=true
CANCEL_ON_RISK=true
CRITICAL_ERROR_LIMIT=3
LOG_LEVEL=INFO
